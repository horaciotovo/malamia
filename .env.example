# Docker Compose Environment Variables
# Copy this to .env and customize as needed

# ─────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────
DB_USER=malamia
DB_PASSWORD=malamia_secret
DB_NAME=malamia_db
DB_PORT=5432

# ─────────────────────────────────────
# Backend API Configuration
# ─────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3001

# JWT Secrets (change these in production!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production

# Cloudinary (optional, for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase (optional, for push notifications)
# Add your firebase-service-account.json to the backend folder

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081,http://localhost:19000,http://localhost:19001

# Loyalty Points
POINTS_PER_PURCHASE_DOLLAR=1

# ─────────────────────────────────────
# Backoffice Configuration
# ─────────────────────────────────────
BACKOFFICE_PORT=5173
VITE_API_URL=http://localhost:3001/api
